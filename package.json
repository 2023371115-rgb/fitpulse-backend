    "express-rate-limit": "^8.5.2",
    "jsonwebtoken": "^9.0.0",
    "multer": "1.4.4",
    "mysql2": "^3.22.5",
    "sharp": "^0.32.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "nodemon": "^2.0.22"
  },
  "nodemonConfig": {
    "ignore": [
      "frontend/",
